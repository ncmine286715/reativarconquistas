# Copie para ".env" ou exporte como variaveis de ambiente no seu host.
# NUNCA commite a chave real no git.
ABACATEPAY_API_KEY=abc_SUA_CHAVE_DE_PRODUCAO
# Em desenvolvimento, use sua chave abc_dev_... (sandbox, sem cobrança real).
# Nunca commite a chave real: este arquivo é só modelo (.env está no .gitignore).

# OBRIGATORIO p/ chaves abc_dev_... (API v2): crie o produto no dashboard
# AbacatePay (Produtos -> Novo produto -> nome "Premium 30 dias", preco 14.90,
# pagamento unico) e cole o ID aqui. Ex.: prod_abc123xyz
ABACATEPAY_PRODUCT_ID=
# Chaves antigas (v1) criam a cobranca sozinhas e nao precisam disso.

# Segredo opcional do webhook (recomendado): gere algo aleatorio e cadastre
# a URL https://seudominio.com.br/api/abacate/webhook?secret=VALOR no AbacatePay.
ABACATEPAY_WEBHOOK_SECRET=

# E-mail de saida (codigo de 6 digitos p/ confirmar a conta). Sem isso, o site
# funciona em "modo teste": a conta ja nasce verificada e o codigo sai no terminal.
# Gmail: crie uma "senha de app" (Conta Google -> Seguranca -> Senhas de app) e use:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seuemail@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# SMTP_FROM=seuemail@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

ABACATEPAY_BASE_V1=https://api.abacatepay.com/v1
ABACATEPAY_BASE_V2=https://api.abacatepay.com/v2
PREMIUM_PRICE_CENTS=699
PREMIUM_DAYS=30
PREMIUM_PRODUCT_NAME=ReativaConquistas Premium — 30 dias
FREE_PER_WEEK=1
MAX_UPLOAD_MB=100
# URL publica do site (para o AbacatePay voltar apos pagar). Ex.:
# PUBLIC_BASE_URL=https://seudominio.com.br
PUBLIC_BASE_URL=http://localhost:8080
PORT=8080
